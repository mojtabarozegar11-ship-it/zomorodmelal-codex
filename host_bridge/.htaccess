Options -Indexes

# Keep diagnostics and documentation private.
<FilesMatch "^(\.env|.*\.log|.*\.json|README\.md|INTEGRATION_COMPLETE\.md)$">
    Require all denied
</FilesMatch>

<Files "install.sh">
    Require all denied
</Files>

<Files "report.sh">
    Require all denied
</Files>

<Files "openapi.yaml">
    Require all denied
</Files>

<Files "receive.php">
    Require all granted
</Files>

<Files "status.php">
    Require all granted
</Files>

<Files "health.php">
    Require all granted
</Files>

<Files "files.php">
    Require all granted
</Files>
