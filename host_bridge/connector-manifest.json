{
  "name": "zomorodmelal-host-bridge",
  "version": "1.0.0",
  "base_url": "https://zomorodmelal.ir/host_bridge",
  "transport": "https",
  "authentication": {
    "type": "bearer",
    "header": "Authorization"
  },
  "endpoints": {
    "file_operation": {
      "method": "POST",
      "path": "/files.php",
      "content_type": "application/json"
    },
    "health": {
      "method": "GET",
      "path": "/health.php"
    },
    "status": {
      "method": "GET",
      "path": "/status.php?health=1"
    }
  },
  "operations": [
    "status",
    "list_directory",
    "read_file",
    "file_info",
    "create_file",
    "write_file",
    "create_directory",
    "delete_file"
  ],
  "security": {
    "token_location": "/home/zomorodm/.host_bridge_token",
    "root": "/home/zomorodm/zomorodmelal-app",
    "no_shell_execution": true,
    "https_required": true
  }
}
